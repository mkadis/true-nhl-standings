# Neon connection strings. In the Neon dashboard, copy the "pooled" string
# for DATABASE_URL and the "direct" (non-pooled) string for DIRECT_URL —
# Prisma needs the direct one to run migrations.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/truenhlstandings?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/truenhlstandings?sslmode=require"

# Google Analytics measurement id (Admin -> Data streams -> your web stream).
# Optional: leave blank to disable tracking, e.g. for local development.
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
